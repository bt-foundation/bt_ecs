{
  "version": 10,
  "configurePresets": [
    {
      "name": "WindowsBase",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "LinuxBase",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER":"clang",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "MacosBase",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER":"clang",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "Windows Debug",
      "displayName": "x64 Debug",
      "inherits": "WindowsBase",
      "binaryDir": "${sourceDir}/build/win64",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Windows Release",
      "displayName": "x64 Release",
      "inherits": "WindowsBase",
      "binaryDir": "${sourceDir}/build/win64",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Linux Debug",
      "displayName": "x64 Debug",
      "inherits": "LinuxBase",
      "binaryDir": "${sourceDir}/build/linux64",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Linux Release",
      "displayName": "x64 Release",
      "inherits": "LinuxBase",
      "binaryDir": "${sourceDir}/build/linux64",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Macos Debug",
      "displayName": "Arm64 Debug",
      "inherits": "MacosBase",
      "binaryDir": "${sourceDir}/build/macos64",
      "architecture": {
        "value": "arm64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Macos Release",
      "displayName": "Arm64 Release",
      "inherits": "MacosBase",
      "binaryDir": "${sourceDir}/build/macos64",
      "architecture": {
        "value": "arm64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}
